# .env.example — copy to .env and fill values for local testing
RESEND_API_KEY=your_resend_api_key_here
PASSWORD_RESET_FROM_EMAIL="Your App <onboarding@resend.dev>"
PASSWORD_RESET_APP_NAME="Your App"
PASSWORD_RESET_TTL_MINUTES=10

