# ─────────────────────────────────────────────────────────────
# .env.example
# Set these as Supabase Edge Function secrets via:
#   supabase secrets set KEY=value
# ─────────────────────────────────────────────────────────────

# ── Supabase (auto-injected in Edge Functions, listed for reference) ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ── Khalti Payment Gateway ───────────────────────────────────
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_BASE_URL=https://a.khalti.com

# ── eSewa Payment Gateway ────────────────────────────────────
ESEWA_MERCHANT_CODE=your_esewa_merchant_code
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

# ── CORS: restrict edge functions to your production domain ──
PAYMENT_WEBSITE_URL=https://your-production-domain.com

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
PAYMENT_RECEIPT_FROM_EMAIL="Rent A Vehicle <onboarding@resend.dev>"
PASSWORD_RESET_FROM_EMAIL="Rent A Vehicle <onboarding@resend.dev>"
PAYMENT_APP_NAME="Rent A Vehicle Nepal"

# ── Password Reset ───────────────────────────────────────────
PASSWORD_RESET_TTL_MINUTES=10

# ── Partial Payment ──────────────────────────────────────────
PARTIAL_PAYMENT_PERCENT=0.60

# ── Optional: Resend dev redirect (only for @resend.dev senders) ──
# RESEND_DEV_REDIRECT_TO=you@yourdomain.com
