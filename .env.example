# ─────────────────────────────────────────────
# ASSelf Car Rental — Environment Variables
# Copy this file to .env.local for local development.
# On Vercel, add these under Project Settings → Environment Variables.
# ─────────────────────────────────────────────

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
